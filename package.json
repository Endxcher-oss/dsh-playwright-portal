{
  "name": "dsh-playwright-portal",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin: Playwright interactive browsing with accessibility-tree snapshots, persistent profiles, navigation guides, and per-session tool toggling. All Playwright state is stored under ~/.dsh/playwright.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "LICENSE",
    "README.md",
    "UPSTREAM.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "node-html-parser": "^6.1.0",
    "playwright": "1.62.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-only",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "playwright",
    "browser",
    "accessibility-tree",
    "web"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Endxcher-oss/dsh-playwright-portal.git"
  },
  "homepage": "https://github.com/Endxcher-oss/dsh-playwright-portal#readme",
  "bugs": {
    "url": "https://github.com/Endxcher-oss/dsh-playwright-portal/issues"
  }
}
